<?xml version="1.0" encoding="utf-8"?>
<!-- 图标统一用「描边」而不是实心：一屏四个实心块太重，描边在 18dp 下也更清楚。
     颜色一律写死成黑色，由使用处的 app:tint 决定实际色——
     这样同一个图标在总开关（品牌蓝）和防跳转（绿）上可以复用。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="20"
    android:viewportHeight="20">
    <path
        android:pathData="M10,2.7 L10,9.2"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeWidth="1.7" />
    <path
        android:pathData="M5.5,5.33 A6.25,6.25 0 1 0 14.5,5.33"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeWidth="1.7" />
</vector>
