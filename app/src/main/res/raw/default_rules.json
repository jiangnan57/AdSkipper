{
  "_note": "内置规则只是起始模板。不同 App 版本改版频繁，建议用「节点探测器」抓到自己手机上的真实控件后，在「规则管理」里写自定义规则覆盖。",
  "version": 1,
  "defaults": {
    "keywords": [
      "跳过",
      "跳过广告",
      "跳过开屏",
      "关闭广告",
      "关闭开屏",
      "关闭开屏广告",
      "跳过开屏广告",
      "点击跳过",
      "跳过 >",
      "跳过›",
      "Skip Ad",
      "Skip",
      "skip",
      "跳过动画",
      "tv_skip",
      "skip_btn"
    ],
    "exclude": [
      "跳过登录",
      "跳过引导",
      "跳过教程",
      "跳过新手",
      "跳过设置",
      "跳过此步",
      "跳过验证",
      "跳过绑定",
      "跳过介绍",
      "跳过说明",
      "跳过并",
      "跳过实名",
