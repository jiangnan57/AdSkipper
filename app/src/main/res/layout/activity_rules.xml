<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 规则库：显示「现在用的是第几版、多少条」，并给一个能手动拉新的按钮。
         自动同步是每 6 小时一次、且只在打开首页时触发，用户看到「我刚加了规则，
         手机怎么没变」时需要一个自己动手的地方。 -->
    <LinearLayout
        android:id="@+id/cardLib"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@color/card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="规则库"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLib"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="v3 · 345 条规则\n11-28 更新 · 长按换地址" />

            <!-- 同步结果就显示在按钮下方。放到页面底部的 hint 里，
                 用户点完按钮往下一看什么都没有，还得滚到底才知道成没成。 -->
            <TextView
                android:id="@+id/tvLibMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="已更新到 v4（345 条）"
                tools:visibility="visible" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLibSync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:text="获取最新规则"
            android:textSize="12sp"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- 现场学到的规则：单独一块，能看、能复制、能删 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@color/card"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTaught"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="已学会 3 条弹窗规则 · 查看 / 复制 / 删除" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTaughtClear"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="清空"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 学会的规则只在这台手机上生效，要有人送回开发者才能变成公共规则 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTaughtSend"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="8dp"
            android:text="@string/rule_survey_send"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:text="在这里写自定义规则，保存后立即生效（会与内置规则合并）。\n\n开屏规则：{&quot;keywords&quot;:[&quot;关闭广告&quot;]} 覆盖默认关键词；{&quot;keywords_append&quot;:[&quot;tv_skip&quot;]} 追加。\n\n弹窗规则：{&quot;popups&quot;:[{&quot;when&quot;:[&quot;检测到更新&quot;],&quot;action&quot;:[&quot;以后再&quot;]}]}\n\n文字默认模糊匹配，支持 + 开头 / - 结尾 / = 全等 / &amp; 连接多个条件。"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etRules"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@color/card"
        android:fontFamily="monospace"
        android:gravity="top|start"
        android:inputType="textMultiLine|textNoSuggestions"
        android:padding="12dp"
        android:scrollbars="vertical"
        android:textColor="@color/text_primary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="保存"
            android:textSize="14sp"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnValidate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="校验"
            android:textSize="14sp"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTemplate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="模板"
            android:textSize="14sp"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
